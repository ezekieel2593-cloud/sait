# ---------------------------------------------------------------------------
# Общие настройки
# ---------------------------------------------------------------------------
NODE_ENV=development

# Публичный адрес сайта (используется в ссылках уведомлений и canonical URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Секрет для подписи cookies сессии. Сгенерируйте: openssl rand -hex 32
AUTH_SECRET=replace-with-32-byte-hex

# Путь к файлу базы данных SQLite (первый релиз).
# Для PostgreSQL смотрите docs/DEPLOYMENT.md (адаптер БД изолирован в src/lib/db).
DATABASE_PATH=./data/app.db

# ---------------------------------------------------------------------------
# Уведомления
# ---------------------------------------------------------------------------
# Telegram: токен от @BotFather и chat_id получателя (личный чат, не публичный)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MAX (platform-api.max.ru): требуется верифицированное юрлицо и одобренный бот
MAX_BOT_TOKEN=
MAX_CHAT_ID=
MAX_API_BASE=https://platform-api.max.ru

# SMTP для email-уведомлений
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Astra Pearl <no-reply@example.com>"
# Адрес по умолчанию для уведомлений о заявках (меняется в настройках кабинета)
MAIL_ADMIN=owner@example.com

# ---------------------------------------------------------------------------
# Геокодирование (необязательно)
# ---------------------------------------------------------------------------
# Локальная база городов работает всегда. Внешний геокодер включается опционально.
GEOCODER_PROVIDER=off
GEOCODER_USER_AGENT="astra-pearl/1.0 (contact@example.com)"

# ---------------------------------------------------------------------------
# Ограничения
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_CALCULATIONS=30
RATE_LIMIT_MAX_LEADS=5
RATE_LIMIT_MAX_LOGIN=8
