# Настройки деплоя на хостинг (Cloud4box / ISPmanager и любой хостинг с FTP).
# Скопируйте файл в .env.deploy и заполните свои данные:
#   cp .env.deploy.example .env.deploy
# .env.deploy в git не попадает — пароль остаётся только у вас.
#
# В панели Cloud4box нужны только эти данные — из раздела «FTP-доступы»:
# хост, логин, пароль и папка сайта.

FTP_HOST=ваш-домен.ru
FTP_USER=логин-ftp
FTP_PASSWORD=пароль-из-панели

# Папка сайта на сервере (она же «директория»). Обычно public_html.
FTP_DIR=public_html

# --- Необязательное: оставьте как есть, если хостинг не просит иначе ---
# Порт: 21 — стандартный для FTP.
FTP_PORT=21
# Шифрование FTPS. Обычно не нужно: 0 = обычный FTP.
FTP_SECURE=0
