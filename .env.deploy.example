# Настройки автодеплоя на хостинг (Cloud4box / ISPmanager и любой shared-хостинг с FTP).
# Скопируйте файл в .env.deploy и заполните своими данными:
#   cp .env.deploy.example .env.deploy
# .env.deploy в git не попадает — пароль остаётся только у вас.
#
# Где взять: панель Cloud4box (ISPmanager) → «FTP-учётные записи».

FTP_HOST=ваш-домен.ru
FTP_USER=логин-ftp
FTP_PASSWORD=пароль-из-панели

# Каталог сайта на сервере. На Cloud4box и большинстве ISPmanager — public_html.
FTP_REMOTE=public_html

# Порт: 21 для обычного FTP и FTPS.
FTP_PORT=21

# 1 — включить FTPS (шифрование). Если хостинг не поддерживает — 0.
FTP_SECURE=0
